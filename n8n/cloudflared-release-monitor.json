{
  "name": "cloudflared release monitor -> rebuild hEX S image",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 6 }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/cloudflare/cloudflared/releases/latest",
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Get latest cloudflared release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const tag = $json.tag_name;\nconst store = $getWorkflowStaticData('global');\nconst changed = store.lastTag !== tag;\nif (changed) { store.lastTag = tag; }\nreturn [{ json: { version: tag, changed } }];"
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "New version?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.changed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/bossoq/cloudflared-hexs-armv5/actions/workflows/build.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" },
            { "name": "User-Agent", "value": "n8n-cloudflared-monitor" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ref\": \"main\",\n  \"inputs\": { \"version\": \"{{ $json.version }}\" }\n}",
        "options": {}
      },
      "id": "a5555555-5555-4555-8555-555555555555",
      "name": "Trigger build (workflow_dispatch)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 220],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_GH_PAT_CREDENTIAL", "name": "github-pat (Bearer)" }
      }
    }
  ],
  "connections": {
    "Every 6h": { "main": [[{ "node": "Get latest cloudflared release", "type": "main", "index": 0 }]] },
    "Get latest cloudflared release": { "main": [[{ "node": "New version?", "type": "main", "index": 0 }]] },
    "New version?": { "main": [[{ "node": "Changed?", "type": "main", "index": 0 }]] },
    "Changed?": { "main": [[{ "node": "Trigger build (workflow_dispatch)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
